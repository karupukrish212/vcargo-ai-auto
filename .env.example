APP_ENV=development
LOG_LEVEL=INFO

# Use a dedicated account with SELECT and optional SHOW VIEW on this database only.
# Never use root, application write credentials, or a database URL copied from the ERP.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_CONNECT_TIMEOUT_SECONDS=5
MYSQL_READ_TIMEOUT_SECONDS=10
MYSQL_EXECUTION_TIMEOUT_MS=5000
MYSQL_POOL_SIZE=5
MYSQL_POOL_RECYCLE_SECONDS=1800

# Require certificate verification in production. Container paths must be mounted.
MYSQL_SSL_CA=
MYSQL_SSL_CERT=
MYSQL_SSL_KEY=

SCHEMA_OUTPUT_PATH=metadata/generated/schema_raw.json
# Opt-in integration test; must point at a disposable, DBA-provisioned fixture database.
RUN_MYSQL_INTEGRATION=0
# Read-only completeness/readiness check against an already extracted real catalog.
RUN_MYSQL_CATALOG_INTEGRATION=0
